{
  "dashboard": {
    "title": "k8s-cleaner Performance Dashboard",
    "tags": ["k8s-cleaner", "performance", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 2,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{container=\"controller\"}[5m]) / container_spec_cpu_quota{container=\"controller\"} * 100",
            "legendFormat": "CPU Usage %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 50, "color": "yellow"},
                {"value": 80, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Memory Usage",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "container_memory_usage_bytes{container=\"controller\"} / container_spec_memory_limit_bytes{container=\"controller\"} * 100",
            "legendFormat": "Memory Usage %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 70, "color": "yellow"},
                {"value": 85, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Run Rate (QPS)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(k8s_cleaner_runs_total[5m]))",
            "legendFormat": "Runs/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(k8s_cleaner_error_resources_total[5m])) / sum(rate(k8s_cleaner_runs_total[5m]))",
            "legendFormat": "Error Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0.01, "color": "yellow"},
                {"value": 0.05, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Run Duration (P95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(k8s_cleaner_run_duration_seconds_bucket[5m])) by (le, cleaner_instance))",
            "legendFormat": "P50 - {{cleaner_instance}}"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(k8s_cleaner_run_duration_seconds_bucket[5m])) by (le, cleaner_instance))",
            "legendFormat": "P95 - {{cleaner_instance}}"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(k8s_cleaner_run_duration_seconds_bucket[5m])) by (le, cleaner_instance))",
            "legendFormat": "P99 - {{cleaner_instance}}"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },
      {
        "id": 6,
        "title": "Resource Usage Trend",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{container=\"controller\"}[5m])",
            "legendFormat": "CPU Usage"
          },
          {
            "expr": "container_memory_usage_bytes{container=\"controller\"} / 1024 / 1024",
            "legendFormat": "Memory Usage (MB)"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Usage"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1
      },
      {
        "id": 7,
        "title": "API Call Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "sum(rate(apiserver_request_total{resource=\"*\"}[5m])) by (verb)",
            "legendFormat": "{{verb}}"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Requests/sec"},
          {"format": "short"}
        ],
        "stack": true,
        "fill": 10
      },
      {
        "id": 8,
        "title": "API Latency (P95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(apiserver_request_duration_seconds_bucket{resource=\"*\"}[5m])) by (le, verb))",
            "legendFormat": "{{verb}}"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1
      },
      {
        "id": 9,
        "title": "Operations per Cleaner",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "sum(rate(k8s_cleaner_deleted_resources_total[5m])) by (cleaner_instance)",
            "legendFormat": "Deleted - {{cleaner_instance}}"
          },
          {
            "expr": "sum(rate(k8s_cleaner_updated_resources_total[5m])) by (cleaner_instance)",
            "legendFormat": "Updated - {{cleaner_instance}}"
          },
          {
            "expr": "sum(rate(k8s_cleaner_scan_resources_total[5m])) by (cleaner_instance)",
            "legendFormat": "Scanned - {{cleaner_instance}}"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Operations/sec"},
          {"format": "short"}
        ],
        "stack": true,
        "fill": 10
      }
    ]
  }
}

