{
  "dashboard": {
    "title": "k8s-cleaner Dashboard",
    "tags": ["k8s-cleaner", "kubernetes", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Cleaner Runs Total",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(k8s_cleaner_runs_total[5m]))",
            "legendFormat": "Runs/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 2,
        "title": "Cleaner Run Duration (P95)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(k8s_cleaner_run_duration_seconds_bucket[5m])) by (le, cleaner_instance))",
            "legendFormat": "{{cleaner_instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Resources Deleted",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(k8s_cleaner_deleted_resources_total[5m]))",
            "legendFormat": "Deleted/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(k8s_cleaner_error_resources_total[5m])) / sum(rate(k8s_cleaner_runs_total[5m]))",
            "legendFormat": "Error Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0.01, "color": "yellow"},
                {"value": 0.05, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Run Duration Distribution",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(k8s_cleaner_run_duration_seconds_bucket[5m])) by (le, cleaner_instance))",
            "legendFormat": "P50 - {{cleaner_instance}}"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(k8s_cleaner_run_duration_seconds_bucket[5m])) by (le, cleaner_instance))",
            "legendFormat": "P95 - {{cleaner_instance}}"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(k8s_cleaner_run_duration_seconds_bucket[5m])) by (le, cleaner_instance))",
            "legendFormat": "P99 - {{cleaner_instance}}"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Resource Operations Trend",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(k8s_cleaner_deleted_resources_total[5m])) by (resource_type)",
            "legendFormat": "Deleted - {{resource_type}}"
          },
          {
            "expr": "sum(rate(k8s_cleaner_updated_resources_total[5m])) by (resource_type)",
            "legendFormat": "Updated - {{resource_type}}"
          },
          {
            "expr": "sum(rate(k8s_cleaner_scan_resources_total[5m])) by (resource_type)",
            "legendFormat": "Scanned - {{resource_type}}"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Operations/sec"},
          {"format": "short"}
        ],
        "stack": true,
        "fill": 10
      }
    ]
  }
}

